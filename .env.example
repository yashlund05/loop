# LOOP Environment Variables Template (Development with Hosted Supabase Dev Project)
# NOTE: Never commit real keys, secrets, or production credentials to git.

# -----------------------------------------------------------------------------
# Backend API (apps/api)
# -----------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=development
DEBUG=true

# Database: Point to your hosted Supabase development project PostgreSQL database.
# In Supabase Dashboard -> Project Settings -> Database -> Connection string:
# Transaction pooler (port 6543) or direct session (port 5432).
# Format: postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.exampleprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Hosted Supabase Project URL & API Keys:
# In Supabase Dashboard -> Project Settings -> API:
SUPABASE_URL=https://exampleprojectref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key

# -----------------------------------------------------------------------------
# Frontend Web (apps/web)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://exampleprojectref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key
